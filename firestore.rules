rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(id) { return signedIn() && request.auth.uid == id; }
    function hasEmail() { return signedIn() && request.auth.token.email != null; }
    function isAdmin() {
      return hasEmail() &&
        exists(/databases/$(database)/documents/usuarios_gadm/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/usuarios_gadm/$(request.auth.token.email)).data.ativo != false;
    }
    function isDriver() {
      return signedIn() &&
        exists(/databases/$(database)/documents/entregadores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/entregadores/$(request.auth.uid)).data.aprovado == true &&
        get(/databases/$(database)/documents/entregadores/$(request.auth.uid)).data.ativo == true;
    }
    function isOwnDriver(id) { return isDriver() && request.auth.uid == id; }
    function targetedToMe() {
      return isDriver() && (
        ('targetDriverId' in resource.data && resource.data.targetDriverId == request.auth.uid) ||
        ('ofertaParaEntregadorId' in resource.data && resource.data.ofertaParaEntregadorId == request.auth.uid) ||
        ('entregadorSelecionadoId' in resource.data && resource.data.entregadorSelecionadoId == request.auth.uid) ||
        ('entregadorOfertaId' in resource.data && resource.data.entregadorOfertaId == request.auth.uid) ||
        ('entregadorId' in resource.data && resource.data.entregadorId == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid)
      );
    }
    function assignedToMe() {
      return isDriver() && (
        ('entregadorId' in resource.data && resource.data.entregadorId == request.auth.uid) ||
        ('driverId' in resource.data && resource.data.driverId == request.auth.uid) ||
        ('rotaComplementoEntregadorId' in resource.data && resource.data.rotaComplementoEntregadorId == request.auth.uid) ||
        ('entregadorSelecionadoId' in resource.data && resource.data.entregadorSelecionadoId == request.auth.uid) ||
        ('entrega' in resource.data && resource.data.entrega is map && 'entregadorId' in resource.data.entrega && resource.data.entrega.entregadorId == request.auth.uid)
      );
    }
    function publicMenu() { return true; }

    match /gadm_operacao/{id} { allow read: if true; allow write: if isAdmin(); }
    match /gadm_config/{id} { allow read: if true; allow write: if isAdmin(); }
    match /configuracao_cardapio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /config_loja/{id} { allow read: if true; allow write: if isAdmin(); }
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
    match /configuracoes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /configuracoesLoja/{id} { allow read: if true; allow write: if isAdmin(); }
    match /configuracoes_loja/{id} { allow read: if true; allow write: if isAdmin(); }
    match /taxas_entrega/{id} { allow read: if true; allow write: if isAdmin(); }
    match /up_config/{id} { allow read: if isAdmin() || isDriver(); allow write: if isAdmin(); }

    match /cardapio_acai/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /bases/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /acompanhamentos_gratis/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /adicionais/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /coberturas/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /bebidas/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }
    match /utensilios/{id} { allow read: if publicMenu(); allow write: if isAdmin(); }

    match /clientes_360/{clientId} {
      allow read: if own(clientId) || isAdmin();
      allow create, update: if own(clientId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /carrinhos_360/{clientId} { allow read, create, update, delete: if own(clientId) || isAdmin(); }

    match /usuarios/{userId} {
      allow read: if own(userId) || isAdmin();
      allow create, update: if own(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /visitas/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /pedidos/{orderId} {
      allow create: if
        (signedIn() && 'cliente' in request.resource.data && request.resource.data.cliente is map && 'uid' in request.resource.data.cliente && request.resource.data.cliente.uid == request.auth.uid) ||
        (!signedIn() && 'status' in request.resource.data && request.resource.data.status in ['NOVO','novo','PENDENTE','pendente']);
      allow read: if isAdmin() || assignedToMe() ||
        (signedIn() && 'cliente' in resource.data && resource.data.cliente is map && 'uid' in resource.data.cliente && resource.data.cliente.uid == request.auth.uid) ||
        (!signedIn() && 'cliente' in resource.data && resource.data.cliente is map && 'tipo' in resource.data.cliente && resource.data.cliente.tipo in ['visitante','VISITANTE']);
      allow update: if isAdmin() || (assignedToMe() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','statusPedido','statusEntrega','entrega','upProtocolVersion','upState','upRouteOpen','pickupConfirmed','ofertaAtiva','ofertaAceita','corridaAtiva','emCorrida',
          'acceptedAt','aceitaEm','pickupStartedAt','chegouColetaEm','deliveryStartedAt','saiuEntregaEm','arrivedClientAt',
          'aguardandoCodigoEntrega','concluidaEm','entregueEm','finishedAt','finalizado','rastreamentoVisivelCliente',
          'rejeitadaPor','lastRejectedBy','motivoRejeicao','rejeitadaEm','pendenteGestor','acaoNecessariaGestor',
          'pagamentoRecebidoPeloEntregador','acerto','financeiro','financeiroConferidoPeloApp','updatedAt','atualizadoEm','statusAtualizadoEm',
          'lastExpiredFor','chegouLojaEm','retiradoEm','chegouClienteEm','entregadorId','entregadorUid','driverId','corridaAtualId','ultimaAcaoEntregador',
          'rotaId','rotaAtualId','rotaPlanejadaId','rotaPlanejadaOrdem','rotaPlanejada','rotaComplementoOfertaId','rotaComplementoEntregadorId',
          'localizacaoEntregador','entregadorLat','entregadorLng','entregadorAccuracy','entregadorSpeed','localizacaoEntregadorAtualizadaEm'
        ]));
      allow delete: if isAdmin();
    }

    // Cadastro + perfil do entregador. Novas contas usam o UID do Firebase Auth como ID do documento.
    match /entregadores/{driverId} {
      allow read: if isAdmin() || own(driverId);
      allow create: if isAdmin() || (own(driverId) &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.aprovado == false &&
        request.resource.data.ativo == false &&
        request.resource.data.statusAprovacao == 'PENDENTE');
      allow delete: if isAdmin();
      allow update: if isAdmin() || (own(driverId) && (
        // Enquanto aguarda análise, o próprio entregador pode corrigir somente dados cadastrais.
        (resource.data.aprovado != true && request.resource.data.aprovado != true && request.resource.data.ativo != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome','email','cpf','nascimento','telefone','cep','rua','numero','bairro','cidade',
            'tipoVeiculo','marcaVeiculo','modeloVeiculo','corVeiculo','placa','pixTipo','pixChave','pixTitular',
            'fotoUrl','documentoUrl','authUid','origemCadastro','appVersionCadastro','cadastroEnviadoEm','updatedAt',
            'statusCadastro','statusAprovacao','motivoCorrecao'
          ])) ||
        // Depois de aprovado, o app altera apenas estado operacional.
        (isDriver() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'online','status','statusOnline','statusOperacional','upProtocolVersion','upMissionState','upRouteOpen','canReceiveRouteComplement','upOpenRouteId','aceitaNovasOfertas','coords','localizacaoAtualizadaEm','localizacaoOrigem',
          'rastreamentoAtivo','rastreamento','corridaAtiva','emCorrida','corridaAtualId','currentRideId','rideAtualId','missaoAtualId','missaoAtualTipo',
          'fcmToken','pushToken','tokenPush','tokenAtualizadoEm','tokenUpdatedAt','ultimaAceitacaoEm','ultimaConclusaoEm','ultimaMissaoEncerradaId',
          'ultimaOcorrenciaEm','ultimaOcorrenciaId','ultimaOcorrenciaMotivo','recebimentoAtualizadoEm','recebimentoStatus','acerto','totalEntregas','saldoLiquido',
          'ultimoLoginEm','lastLoginAt','appVersion','platform','ofertaAtualId','financeiro','updatedAt',
          'batteryLevel','bateria','bateriaPercentual','charging','carregando','batteryUpdatedAt','bateriaAtualizadaEm','telemetria',
          'temTroco','trocoDisponivel','temMaquininha','maquininhaTipos','operacao','equipamentos'
        ]))
      ));
    }

    match /rides/{rideId} {
      allow read: if isAdmin() || targetedToMe();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (targetedToMe() &&
        request.resource.data.entregadorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ofertaAceita','ofertaAtiva','ofertaParaTodos','broadcast','acceptedAt','aceitaEm','entregadorId','driverId','uidEntregador',
          'status','statusCorrida','statusEntregador','statusOferta','statusOfertaEntregador','statusEntrega','upProtocolVersion','upState','upRouteOpen','pickupConfirmed','corridaAtiva','emCorrida','liberadoParaEntregador',
          'pendenteGestor','acaoNecessariaGestor','ultimaAcaoEntregador','rastreamentoVisivelCliente','statusAtualizadoEm','updatedAt','statusPedido',
          'rejeitadaPor','lastRejectedBy','ultimoRejeitadoPor','rejectionReason','motivoRejeicao','rejeitadaEm','rejectedDriverIds','rejeitados',
          'lastExpiredFor','expiredDriverIds','pickupStartedAt','chegouColetaEm','chegouLojaEm','retiradoEm','deliveryStartedAt','saiuEntregaEm','arrivedClientAt','chegouClienteEm','aguardandoCodigoEntrega',
          'concluidaEm','entregueEm','finishedAt','finalizado','pagamentoRecebidoPeloEntregador','acerto','financeiro','financeiroConferidoPeloApp',
          'localizacaoEntregador','entregadorLat','entregadorLng','entregadorAccuracy','entregadorSpeed','localizacaoEntregadorAtualizadaEm','complementoOfertaAtiva','complementoOferta','complementoRouteId','complementoAceito','ocorrenciaAtiva','statusOcorrencia','ultimaOcorrenciaId','ultimaOcorrenciaMotivo','ultimaOcorrenciaEm'
        ]));
      match /rejections/{id} {
        allow read: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
        allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /rotas_entrega/{routeId} {
      allow read: if isAdmin() || assignedToMe();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (assignedToMe() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ofertaAtiva','ofertaAceita','status','statusCorrida','statusEntrega','statusPedido','upProtocolVersion','upState','upRouteOpen','pickupConfirmed','retiradaConfirmada','statusEntregador','statusOferta','statusOfertaEntregador','entregadorId','driverId','entregadorUid','corridaAtualId','corridaAtiva','emCorrida',
          'pendenteGestor','acaoNecessariaGestor','rejeitadaPor','lastRejectedBy','ultimoRejeitadoPor','rejectionReason','motivoRejeicao','rejeitadaEm','lastExpiredFor',
          'pickupStartedAt','chegouColetaEm','chegouLojaEm','retiradoEm','deliveryStartedAt','saiuEntregaEm','arrivedClientAt','chegouClienteEm','concluidaEm','entregueEm','finishedAt','finalizado','aguardandoCodigoEntrega',
          'rastreamentoVisivelCliente','pagamentoRecebidoPeloEntregador','acerto','financeiro','financeiroConferidoPeloApp','updatedAt','statusAtualizadoEm','ultimaAcaoEntregador','ocorrenciaAtiva','statusOcorrencia','ultimaOcorrenciaId','ultimaOcorrenciaMotivo','ultimaOcorrenciaEm',
          'tipo','acceptedAt','aceitaEm','indiceParadaAtual','paradas','rotaAberta','bloqueadaParaNovosPedidos','entregasConcluidas','recebidoAcumulado','pedidoIds','pedidosIds','qtdPedidos','quantidadePedidos','kmEstimado','valorRepasseEntregador','repasseTotal','rastreamentoPedidosHabilitados','complementoOfertaAtiva','complementoOferta','complementoLinkedRideId','complementoAceito','complementoRespondidoEm','complementoRejeitadoPor','complementoMotivoRejeicao',
          'deliveryStartedAt','saiuEntregaEm','arrivedClientAt','localizacaoEntregador','entregadorLat','entregadorLng','localizacaoEntregadorAtualizadaEm'
        ]));
    }

    match /corridas/{id} { allow read, write: if isAdmin(); }
    match /acertosEntregadores/{id} {
      allow read: if isAdmin() || (isDriver() && resource.data.entregadorId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.entregadorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /appEventosOperacao/{id} {
      allow read: if isAdmin();
      allow create: if isDriver() && request.resource.data.entregadorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /ocorrenciasOperacao/{id} {
      allow read: if isAdmin() || (isDriver() && resource.data.entregadorId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.entregadorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /app_notifications/{id} {
      allow read: if isAdmin() || (isDriver() && ((('targetDriverId' in resource.data) && resource.data.targetDriverId == request.auth.uid) || (('targetDriverIds' in resource.data) && resource.data.targetDriverIds is list && request.auth.uid in resource.data.targetDriverIds)));
      allow write: if isAdmin();
    }
    match /suporteEntregador/{id} {
      allow create: if isDriver() && request.resource.data.entregadorId == request.auth.uid;
      allow read: if isAdmin() || (isDriver() && resource.data.entregadorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /cupons/{couponId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.clienteUid == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.ativo != false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos','ultimoUsoEm','ultimoPedidoUso','ultimoClienteUso','clientesUsaram','ativo','usado','usadoEm','pedidoUso','clienteUso']) &&
        request.resource.data.usos == (resource.data.usos == null ? 1 : resource.data.usos + 1) &&
        (resource.data.clienteUid == null || (signedIn() && resource.data.clienteUid == request.auth.uid))
      );
    }

    match /promocoes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /campanhas_notificacoes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /novidades_cliente/{id} { allow read: if true; allow write: if isAdmin(); }
    match /planos_clube/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ofertas_upsell/{id} { allow read: if true; allow write: if isAdmin(); }
    match /desafios_cliente/{id} { allow read: if true; allow write: if isAdmin(); }
    match /enquetes_cliente/{id} { allow read: if true; allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votos','updatedAt']); allow create, delete: if isAdmin(); }
    match /experimentos_promocao/{id} { allow read: if true; allow create, delete: if isAdmin(); allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsA','viewsB','clicksA','clicksB','convA','convB','gastoEstimado']); }
    match /notificacoes_cliente/{id} { allow read: if true; allow write: if isAdmin(); }
    match /avaliacoes/{id} { allow read: if isAdmin(); allow create, update: if signedIn() && request.resource.data.clienteUid == request.auth.uid; allow delete: if isAdmin(); }
    match /suporte_cliente/{id} { allow create: if signedIn() && request.resource.data.clienteUid == request.auth.uid; allow read: if isAdmin() || (signedIn() && resource.data.clienteUid == request.auth.uid); allow update, delete: if isAdmin(); }
    match /solicitacoes_privacidade/{id} { allow create: if signedIn() && request.resource.data.clienteUid == request.auth.uid; allow read: if isAdmin() || (signedIn() && resource.data.clienteUid == request.auth.uid); allow update, delete: if isAdmin(); }
    match /pedidos_grupo/{id} { allow create: if signedIn() && request.resource.data.criadorUid == request.auth.uid; allow read, update: if signedIn() && request.auth.uid in resource.data.participantes; allow delete: if isAdmin() || (signedIn() && resource.data.criadorUid == request.auth.uid); }
    match /vales_presente/{id} { allow read: if signedIn() || isAdmin(); allow create: if isAdmin() || (signedIn() && request.resource.data.remetenteUid == request.auth.uid); allow update: if isAdmin() || (signedIn() && resource.data.ativo == true && resource.data.usado != true); allow delete: if isAdmin() && resource.data.usado != true; }
    match /indicacoes/{id} { allow create: if signedIn() && request.resource.data.indicadoUid == request.auth.uid; allow read: if isAdmin() || (signedIn() && (resource.data.indicadoUid == request.auth.uid || resource.data.indicadorUid == request.auth.uid)); allow update, delete: if isAdmin(); }
    match /fidelidade_movimentos/{id} { allow create: if isAdmin() || (signedIn() && request.resource.data.clienteUid == request.auth.uid); allow read: if isAdmin() || (signedIn() && resource.data.clienteUid == request.auth.uid); allow update, delete: if isAdmin(); }

    match /gerenciadorinsumos/{id} { allow read, write: if isAdmin(); }
    match /estoque_movimentos/{id} { allow read, write: if isAdmin(); }
    match /fichas_tecnicas/{id} { allow read: if true; allow write: if isAdmin(); }
    match /perdas/{id} { allow read, write: if isAdmin(); }
    match /perdas_estoque/{id} { allow read, write: if isAdmin(); }
    match /fornecedores/{id} { allow read, write: if isAdmin(); }
    match /financeiro_movimentos/{id} { allow read, write: if isAdmin(); }
    match /despesas/{id} { allow read, write: if isAdmin(); }
    match /despesas_gadm/{id} { allow read, write: if isAdmin(); }
    match /metas/{id} { allow read, write: if isAdmin(); }
    match /metas_gadm/{id} { allow read, write: if isAdmin(); }
    match /auditoria/{id} { allow read, write: if isAdmin(); }
    match /auditoria_gadm/{id} { allow read, write: if isAdmin(); }
    match /usuarios_gadm/{id} { allow read: if isAdmin() || (hasEmail() && id == request.auth.token.email); allow write: if isAdmin(); }
    match /reembolsos/{id} { allow read, write: if isAdmin(); }
    match /qualidade_ocorrencias/{id} { allow read, write: if isAdmin(); }
    match /alertas_operacionais/{id} { allow read, write: if isAdmin(); }
    match /notificacoes_gadm/{id} { allow read, write: if isAdmin(); }
    match /configuracoes_financeiras/{id} { allow read, write: if isAdmin(); }

    // Metadados internos das Functions não são acessíveis pelos clientes.
    match /_up_login_attempts/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
